# ---- Copy to .env (never commit .env) ----
NODE_ENV=development
LOG_LEVEL=info

# Postgres (docker compose maps container 5432 -> host 5433)
DATABASE_URL=postgres://growthos:growthos@localhost:5433/growthos
TEST_DATABASE_URL=postgres://growthos:growthos@localhost:5433/growthos_test

# Redis (tests use DB 1 so they never touch dev queues)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# API
API_PORT=4000
# Required on every read/admin API call as the X-Dev-Key header. Pick a long random value.
DEV_KEY=change-me-to-a-long-random-string
# Public base URL of the API; used in install snippets (set to your tunnel URL for real-site tests)
PUBLIC_API_URL=http://localhost:4000
# Set true when running behind cloudflared/ngrok/a reverse proxy so the client IP is read from X-Forwarded-For
TRUST_PROXY=false
RATE_LIMIT_SITE_PER_MIN=600
RATE_LIMIT_IP_PER_MIN=120
# Run pending migrations when the API boots (used by docker compose)
MIGRATIONS_RUN=false

# Worker
SESSION_TIMEOUT_MIN=30
SWEEP_INTERVAL_SEC=30

# Dashboard (Vite exposes VITE_* to the browser — testing builds only)
VITE_API_URL=http://localhost:4000
VITE_DEV_KEY=change-me-to-a-long-random-string

# Demo site
VITE_GROWTHOS_SITE_ID=gos_demo_local
VITE_GROWTHOS_ENDPOINT=http://localhost:4000
