# ---- Copy to .env (never commit .env) ----
NODE_ENV=development
LOG_LEVEL=info

# Postgres (docker compose maps container 5432 -> host 5433)
DATABASE_URL=postgres://growthos:growthos@localhost:5433/growthos
TEST_DATABASE_URL=postgres://growthos:growthos@localhost:5433/growthos_test

# Redis (tests use DB 1 so they never touch dev queues)
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# API
API_PORT=4000
# Required on every read/admin API call as the X-Dev-Key header. Pick a long random value.
DEV_KEY=change-me-to-a-long-random-string
# Public base URL of the API; used in install snippets (set to your tunnel URL for real-site tests)
PUBLIC_API_URL=http://localhost:4000
# Set true when running behind cloudflared/ngrok/a reverse proxy so the client IP is read from X-Forwarded-For
TRUST_PROXY=false
RATE_LIMIT_SITE_PER_MIN=600
RATE_LIMIT_IP_PER_MIN=120
# Run pending migrations when the API boots (used by docker compose)
MIGRATIONS_RUN=false

# Worker
SESSION_TIMEOUT_MIN=30
SWEEP_INTERVAL_SEC=30

# Dashboard (Vite exposes VITE_* to the browser — testing builds only)
VITE_API_URL=http://localhost:4000
VITE_DEV_KEY=change-me-to-a-long-random-string

# Demo site
VITE_GROWTHOS_SITE_ID=gos_demo_local
VITE_GROWTHOS_ENDPOINT=http://localhost:4000

# SEO audit crawler (worker). 2 parallel requests x 650 ms pause ~ 1.5 requests/second.
SEO_CONCURRENCY=2
SEO_CRAWL_DELAY_MS=650
# Allow auditing localhost / private IPs (e.g. the demo site). Keep false anywhere real.
SEO_ALLOW_PRIVATE_HOSTS=false
# Google PageSpeed Insights (Core Web Vitals for the top pages). Works without a key at a low quota.
PAGESPEED_ENABLED=true
PAGESPEED_API_KEY=
PAGESPEED_PAGES=3

# AI insights. Set ONE provider key; without any, the AI endpoints answer 503 ai_not_configured. Never commit keys.
# AI_PROVIDER: anthropic | groq | xai (default: the first provider that has a key).
# AI_MODEL: empty = provider default (claude-opus-5-5 / openai/gpt-oss-120b / grok-4).
AI_PROVIDER=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
AI_MODEL=
# Optional price override (USD per million tokens) so the budget meter is right for your model/plan.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Hard monthly spend cap per site (USD, measured from token usage) and daily Ask AI questions per site.
AI_MONTHLY_BUDGET_USD=20
AI_ASK_DAILY_LIMIT=50
