{
  "name": "@growthos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@growthos/db": "workspace:*",
    "@growthos/shared-types": "workspace:*",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/typeorm": "11.0.3",
    "bullmq": "5.81.5",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "3.25.76",
    "@anthropic-ai/sdk": "1.3.0",
    "@growthos/knowledge": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.9",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15"
  },
  "jest": {
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.e2e-spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
